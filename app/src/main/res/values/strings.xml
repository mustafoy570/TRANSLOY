    <!-- Accessibility service -->
    <string name="accessibility_service_label">Dari Screen Translator</string>
    <string name="accessibility_service_summary">Reads on-screen text so it can be translated into Persian/Dari</string>
    <string name="accessibility_service_description">This service reads the text of the current screen only when you tap the floating translate button, and passes it to the on-device translator. Nothing leaves your phone.</string>

