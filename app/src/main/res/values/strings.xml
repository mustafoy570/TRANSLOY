    <!-- Guide -->
    <string name="guide_title">Setup guide</string>
    <string name="guide_intro">Complete these steps once. Tap each card to open its settings page.</string>
    <string name="guide_step_overlay_title">Allow display over other apps</string>
    <string name="guide_step_overlay_desc">Needed to show the floating button and the translated boxes.</string>
    <string name="guide_step_notifications_title">Allow notifications</string>
    <string name="guide_step_notifications_desc">Required on Android 13 and newer so the translation services can run in the background.</string>
    <string name="guide_step_accessibility_title">Enable the accessibility service</string>
    <string name="guide_step_accessibility_desc">Reads on-screen text instantly. Find “Dari Screen Translator” in the Accessibility settings and turn it on.</string>
    <string name="guide_step_capture_title">Screen capture consent</string>
    <string name="guide_step_capture_desc">Asked automatically the first time an image or game needs translation. Choose “Entire screen”.</string>
    <string name="guide_done">Done</string>

    <!-- How to -->
    <string name="how_to_title">How to use</string>
    <string name="how_to_1">Toggle the big switch on the home screen.</string>
    <string name="how_to_2">A small floating button appears over every app. Drag it anywhere.</string>
    <string name="how_to_3">Tap it once to translate the current screen into Persian/Dari.</string>
    <string name="how_to_4">Tap it again to hide the translations.</string>
    <string name="how_to_5">Long-press the button to force image (OCR) translation.</string>
    <string name="how_to_6">Download language models in advance while you have internet.</string>

